{
    "name": "@apple-protocols/airplay",
    "description": "AirPlay 2 client for Node.js, with MRP remote control, URL playback, audio streaming and RAOP.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/apple-protocols",
        "directory": "packages/airplay"
    },
    "homepage": "https://apple-protocols.dev",
    "bugs": {
        "url": "https://github.com/basmilius/apple-protocols/issues"
    },
    "keywords": [
        "apple",
        "airplay",
        "raop",
        "rtsp",
        "tv",
        "apple tv",
        "homekit"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": "^18.17.0 || >=20.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --noEmit && tsdown",
        "dev": "tsdown --watch",
        "gen:proto": "buf generate"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "typings": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./mrp": {
            "types": "./dist/mrp.d.mts",
            "default": "./dist/mrp.mjs"
        },
        "./raop": {
            "types": "./dist/raop.d.mts",
            "default": "./dist/raop.mjs"
        },
        "./rtsp": {
            "types": "./dist/rtsp.d.mts",
            "default": "./dist/rtsp.mjs"
        }
    },
    "dependencies": {
        "@apple-protocols/core": "workspace:*"
    },
    "devDependencies": {
        "@bufbuild/buf": "^1.70.0",
        "@bufbuild/protobuf": "^2.12.0",
        "@bufbuild/protoc-gen-es": "^2.12.0",
        "@types/bun": "^1.3.14",
        "@types/node": "^25.9.2",
        "tsdown": "^0.22.2"
    }
}
