{
    "name": "@corewire/audio-source",
    "description": "Audio sources and decoders for CoreWire audio streaming: MP3, Ogg, WAV, PCM, FFmpeg, URLs and live input.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/corewire",
        "directory": "packages/audio-source"
    },
    "homepage": "https://corewire.dev",
    "bugs": {
        "url": "https://github.com/basmilius/corewire/issues"
    },
    "keywords": [
        "audio",
        "airplay",
        "mp3",
        "ogg",
        "vorbis",
        "wav",
        "flac",
        "qoa",
        "pcm",
        "ffmpeg",
        "decoder",
        "streaming"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": "^18.17.0 || >=20.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --noEmit && tsdown",
        "dev": "tsdown --watch"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "typings": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "dependencies": {
        "@corewire/core": "workspace:*"
    },
    "devDependencies": {
        "@corewire/airplay": "workspace:*",
        "@types/bun": "^1.3.14",
        "@types/node": "^25.9.2",
        "@wasm-audio-decoders/flac": "^0.2.4",
        "@wasm-audio-decoders/ogg-vorbis": "^0.1.15",
        "audio-buffer": "^6.0.1",
        "audio-type": "^2.4.1",
        "mpg123-decoder": "^1.0.0",
        "node-wav": "^0.0.2",
        "qoa-format": "^1.0.1",
        "tsdown": "^0.22.2"
    }
}
