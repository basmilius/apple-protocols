{
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": false,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": false,
        "declaration": true,
        "isolatedDeclarations": true,
        "isolatedModules": true,
        "rootDir": "..",
        "outDir": "dist",
        "experimentalDecorators": true,
        "noEmit": true,
        "types": [
            "node"
        ],
        "paths": {
            "@corewire/airplay/*": [
                "../airplay/src/*"
            ],
            "@corewire/core/*": [
                "../core/src/*"
            ],
            "@corewire/*": [
                "../*/src"
            ],
            "opack": [
                "../opack/src"
            ],
            "tlv8": [
                "../tlv8/src"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
