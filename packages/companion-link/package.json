{
    "name": "@corewire/companion-link",
    "description": "Companion Link client for Node.js, for remote control, text input, apps, accounts and power of an Apple TV.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/apple-protocols",
        "directory": "packages/companion-link"
    },
    "keywords": [
        "apple",
        "companion link",
        "tv",
        "apple tv",
        "homekit"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": "^18.17.0 || >=20.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --noEmit && tsdown",
        "dev": "tsdown --watch"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "typings": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "dependencies": {
        "@corewire/core": "workspace:*"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^25.9.2",
        "tsdown": "^0.22.2"
    }
}
