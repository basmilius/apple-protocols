{
    "name": "@apple-protocols/devices",
    "description": "Controls an Apple TV or HomePod over AirPlay and Companion Link, and reconnects when the device drops.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/apple-protocols",
        "directory": "packages/devices"
    },
    "homepage": "https://apple-protocols.dev",
    "bugs": {
        "url": "https://github.com/basmilius/apple-protocols/issues"
    },
    "keywords": [
        "apple",
        "airplay",
        "companion link",
        "apple tv",
        "homepod",
        "homepod mini",
        "sdk"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": "^18.17.0 || >=20.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --noEmit && tsdown",
        "dev": "tsdown --watch"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "typings": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./catalog": {
            "types": "./dist/catalog.d.mts",
            "default": "./dist/catalog.mjs"
        }
    },
    "dependencies": {
        "@apple-protocols/airplay": "workspace:*",
        "@apple-protocols/companion-link": "workspace:*",
        "@apple-protocols/core": "workspace:*"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^25.9.2",
        "tsdown": "^0.22.2"
    }
}
