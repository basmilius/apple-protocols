{
    "name": "@basmilius/apple-diagnostics",
    "productName": "Apple Protocols Diagnostics",
    "description": "Diagnostics tool for Apple Protocols.",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/apple-protocols",
        "directory": "packages/diagnostics"
    },
    "keywords": [
        "apple",
        "airplay",
        "companion link",
        "opack",
        "plist",
        "tlv8"
    ],
    "main": "./out/main/index.mjs",
    "scripts": {
        "dev": "electron-vite dev",
        "dev:agent": "electron-vite dev --watch",
        "diag": "bun cli/diag.ts",
        "build": "bun run typecheck && electron-vite build",
        "typecheck": "tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json",
        "pack": "bun run build && electron-builder --publish never",
        "pack:dir": "bun run build && electron-builder --dir --publish never"
    },
    "devDependencies": {
        "@adecore/charts": "^0.66.8",
        "@adecore/shell": "^0.66.8",
        "@adecore/ui": "^0.66.8",
        "@base-ui/react": "^1.9.0",
        "@basmilius/apple-airplay": "workspace:*",
        "@basmilius/apple-audio-source": "workspace:*",
        "@basmilius/apple-common": "workspace:*",
        "@basmilius/apple-companion-link": "workspace:*",
        "@basmilius/apple-encoding": "workspace:*",
        "@basmilius/apple-encryption": "workspace:*",
        "@basmilius/apple-raop": "workspace:*",
        "@basmilius/apple-rtsp": "workspace:*",
        "@basmilius/apple-sdk": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-virtual": "^3.14.11",
        "@types/node": "^25.9.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native-preview": "^7.0.0-dev.20260609.1",
        "@vitejs/plugin-react": "^6.1.0",
        "clsx": "^2.1.1",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0-beta.1",
        "hls.js": "^1.7.3",
        "i18next": "^26.4.2",
        "lucide-react": "^1.65.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.15",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "vite": "^8.2.2",
        "zustand": "^5.0.15"
    }
}
