{
    "name": "@basmilius/apple-diagnostics",
    "description": "Diagnostics Electron app for Apple Protocols.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/apple-protocols",
        "directory": "packages/diagnostics"
    },
    "keywords": [
        "apple",
        "airplay",
        "companion link",
        "opack",
        "plist",
        "tlv8"
    ],
    "private": true,
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build && electron-builder --mac --linux --win",
        "build:dir": "electron-vite build && electron-builder --dir",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json"
    },
    "dependencies": {
        "@basmilius/apple-airplay": "workspace:*",
        "@basmilius/apple-audio-source": "workspace:*",
        "@basmilius/apple-common": "workspace:*",
        "@basmilius/apple-companion-link": "workspace:*",
        "@basmilius/apple-encoding": "workspace:*",
        "@basmilius/apple-encryption": "workspace:*",
        "@basmilius/apple-raop": "workspace:*",
        "@basmilius/apple-sdk": "workspace:*"
    },
    "devDependencies": {
        "@basmilius/vite-preset": "^3.34.0",
        "@flux-ui/application": "^3.0.0-next.66",
        "@flux-ui/components": "^3.0.0-next.66",
        "@flux-ui/internals": "^3.0.0-next.66",
        "@flux-ui/types": "^3.0.0-next.66",
        "@fortawesome/duotone-regular-svg-icons": "^7.2.0",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@types/node": "^25.9.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^6.0.0-beta.1",
        "pinia": "^2.2.6",
        "sass-embedded": "^1.100.0",
        "typescript": "^5.6.3",
        "vite": "^8.0.14",
        "vue": "^3.6.0-beta.12",
        "vue-router": "^4.4.5",
        "vue-tsc": "^2.1.10"
    }
}
