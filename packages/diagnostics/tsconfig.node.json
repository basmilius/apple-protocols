{
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "types": [
            "node"
        ],
        "paths": {
            "@shared/*": [
                "./src/shared/*"
            ],
            "@corewire/airplay": [
                "./../airplay/src"
            ],
            "@corewire/airplay/*": [
                "./../airplay/src/*"
            ],
            "@corewire/audio-source": [
                "./../audio-source/src"
            ],
            "@corewire/companion-link": [
                "./../companion-link/src"
            ],
            "@corewire/core": [
                "./../core/src"
            ],
            "@corewire/core/*": [
                "./../core/src/*"
            ],
            "@corewire/devices": [
                "./../devices/src"
            ]
        }
    },
    "include": [
        "src/main/**/*.ts",
        "src/preload/**/*.ts",
        "src/shared/**/*.ts",
        "cli/**/*.ts",
        "electron.vite.config.ts"
    ]
}
