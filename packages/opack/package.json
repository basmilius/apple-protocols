{
    "name": "opack",
    "description": "Encoder and decoder for OPack, Apple's compact binary object format.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "homepage": "https://corewire.dev/reference/opack",
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/apple-protocols",
        "directory": "packages/opack"
    },
    "keywords": [
        "opack",
        "apple",
        "companion link",
        "binary",
        "serialization",
        "codec"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": "^18.17.0 || >=20.3.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --noEmit && tsdown"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "tsdown": "^0.22.2"
    }
}
