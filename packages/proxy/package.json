{
    "name": "@basmilius/apple-proxy",
    "description": "MITM proxy for Apple protocols \u2014 terminates pairing, logs plaintext, and relays to a real device.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bas Milius",
        "email": "bas@mili.us",
        "url": "https://bas.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/basmilius/apple-protocols",
        "directory": "packages/proxy"
    },
    "keywords": [
        "apple",
        "airplay",
        "companion link",
        "proxy",
        "mitm"
    ],
    "files": [
        "dist",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsgo && bun -b build.ts",
        "dev": "bun run src/index.ts",
        "start": "bun run src/index.ts",
        "check": "tsgo --noEmit && bun build src/index.ts --target=bun --outdir dist/check"
    },
    "dependencies": {
        "@basmilius/apple-airplay": "workspace:*",
        "@basmilius/apple-common": "workspace:*",
        "@basmilius/apple-companion-link": "workspace:*",
        "@basmilius/apple-encoding": "workspace:*",
        "@basmilius/apple-encryption": "workspace:*",
        "@basmilius/apple-rtsp": "workspace:*",
        "enquirer": "^2.4.1",
        "ora": "^9.3.0"
    },
    "devDependencies": {
        "@basmilius/tools": "^3.35.0",
        "@types/bun": "^1.3.12",
        "@types/node": "^25.9.2"
    },
    "private": true
}
